# MySQL / Sequelize
#
# ACESSO REMOTO — requer túnel SSH ativo antes de correr o seed:
#
#   Porta livre (sem conflito local):
#   ssh -L 3307:localhost:3306 utilizador@ip-do-servidor -N
#
#   Se a porta 3306 estiver livre localmente, podes usar:
#   ssh -L 3306:localhost:3306 utilizador@ip-do-servidor -N
#   (e trocar DB_PORT abaixo para 3306)
#
# Deixa o terminal do túnel aberto enquanto corres: npm run seed:sql
#
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nome_da_base_de_dados
DB_USER=utilizador
DB_PASSWORD=password
DB_DIALECT=mysql

# MongoDB / Mongoose
#
# ACESSO REMOTO — requer túnel SSH ativo antes de correr o seed:
#
#   Porta livre (sem conflito local):
#   ssh -L 27018:localhost:27017 utilizador@ip-do-servidor -N
#
#   Se a porta 27017 estiver livre localmente, podes usar:
#   ssh -L 27017:localhost:27017 utilizador@ip-do-servidor -N
#   (e trocar a porta no MONGODB_URI abaixo para 27017)
#
# Deixa o terminal do túnel aberto enquanto corres: npm run seed:nosql
#
MONGODB_URI=mongodb://127.0.0.1:27018/nome_da_base_de_dados
MONGODB_DB_NAME=nome_da_base_de_dados
MONGODB_USER=utilizador
MONGODB_PASSWORD=password
MONGODB_AUTH_SOURCE=nome_da_base_de_dados

# Aplicacao
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Seguranca
JWT_SECRET=uma_string_longa_e_aleatoria_aqui
JWT_EXPIRES_IN=24h

# Lockers / PIN
PIN_EXPIRY_HOURS=168
PIN_LENGTH=6

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=o_vosso_email@gmail.com
MAIL_PASS=a_vossa_password_email
MAIL_FROM=noreply@sam.pt

# Gateway de Pagamento
SIBS_API_KEY=
SIBS_API_URL=https://api.sibs.pt
MBWAY_API_KEY=
